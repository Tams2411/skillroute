# Career Pivot Coach - Environment Variables
# Copy this file to .env and fill in your values

# AI Provider (choose one or more)
# OpenRouter (supports multiple models)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Alternative: Direct provider
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model selection (used when multiple providers available)
AI_MODEL=openrouter/auto
AI_FALLBACK_MODEL=openrouter/anthropic/claude-3-haiku

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-change-in-production

# Database (SQLite for local, PostgreSQL for hosted)
DATABASE_URL=sqlite:///./data/career_coach.db

# PDF processing limits
MAX_PDF_SIZE_MB=5
MAX_PDF_PAGES=10
PDF_EXTRACTION_TIMEOUT_SECONDS=30

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost